<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" fx:controller="com.mycompany.cifrasydivisores.PrimaryController">
    <children>
        <HBox alignment="CENTER" spacing="20.0">
            <Label text="Ingrese un número" />
            <TextField fx:id="txtNumero" />
            <Button fx:id="btnAnalizar" text="Analizar" onAction="#analizar" />
            <Button fx:id="btnLimpiar" text="Limpiar" onAction="#limpiar" />
        </HBox>

        <HBox alignment="CENTER" spacing="40.0">
            <GridPane hgap="15.0" vgap="10.0">
                <Label text="Cantidad de cifras" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtCanCifras" editable="false" prefColumnCount="8" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Suma de cifras impares" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtSumaImpares" editable="false" prefColumnCount="8" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Suma de cifras pares" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="txtSumaPares" editable="false" prefColumnCount="8" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Suma total de cifras" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="txtSumTotal" editable="false" prefColumnCount="8" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Cifra mayor" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <TextField fx:id="txtCifraMay" editable="false" prefColumnCount="8" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <Label text="Cifra menor" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                <TextField fx:id="txtCifraMen" editable="false" prefColumnCount="8" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            </GridPane>

            <VBox spacing="5.0">
                <Label text="Divisores" />
                <TextArea fx:id="txtDivisores" editable="false" prefColumnCount="12" prefRowCount="10" />
            </VBox>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
