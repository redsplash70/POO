<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<HBox xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8.0.171" alignment="CENTER" spacing="40.0" fx:controller="com.mycompany.gastossemanales.PrimaryController">
    <children>
        <VBox alignment="CENTER_LEFT" spacing="20.0">
            <GridPane hgap="15.0" vgap="10.0">
                <Label text="Alimentación" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtAlimentacion" alignment="CENTER_RIGHT" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Refrigerios" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtRefrigerios" alignment="CENTER_RIGHT" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Transporte" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="txtTransporte" alignment="CENTER_RIGHT" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Telefonía" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="txtTelefonia" alignment="CENTER_RIGHT" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Otros" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <TextField fx:id="txtOtros" alignment="CENTER_RIGHT" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            </GridPane>

            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <Button fx:id="btnEstadisticas" text="Calcular estadísticas" onAction="#estadisticas" />
                <Button fx:id="btnLimpiar" text="Limpiar" onAction="#limpiar" />
            </HBox>
        </VBox>

        <VBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="Estadísticas" />
            <Label text="Total semanal" />
            <TextField fx:id="txtTotalSemanal" editable="false" alignment="CENTER_RIGHT" />
            <Label text="Gasto más alto" />
            <TextField fx:id="txtMayorGasto" editable="false" alignment="CENTER_RIGHT" />
        </VBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</HBox>
